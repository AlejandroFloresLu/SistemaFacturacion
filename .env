# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Base de datos ─────────────────────────────────────────────────────────────
# MODO LOCAL: define las variables individuales (sin DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=toor
DB_NAME=factu

# MODO CLOUD (Render / Railway / Supabase): descomenta DATABASE_URL y
# comenta las variables DB_* de arriba. La URL incluye host, usuario,
# contraseña y base de datos en un solo string.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=factu_super_secret_key_2025_change_in_production
